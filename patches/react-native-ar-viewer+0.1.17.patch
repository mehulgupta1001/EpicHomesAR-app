+        hasCapturedInitialScale = true
+        
+        // Calculate minimum scale limit
+        val absoluteMinScale = 0.2f
+        val relativeMinScale = currentScale.x * 0.5f
+        minScaleLimit = Math.max(absoluteMinScale, relativeMinScale)
+        
+        Log.d("ARview scale", "CustomScaleController: Captured initial scale: ${initialScale}, minScaleLimit=${minScaleLimit}")
+      }
+    }
+    
+    // Call parent implementation to handle the pinch gesture
+    super.onContinueTransformation(gesture)
+    
+    // CRITICAL: Immediately clamp the scale to prevent going below minimum during gesture
+    // This prevents the model from flipping upside down while pinching
