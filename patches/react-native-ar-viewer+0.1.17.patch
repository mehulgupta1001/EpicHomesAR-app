+        transformableNode.localScale = Vector3(minScaleLimit!!, minScaleLimit!!, minScaleLimit!!)
+        Log.d("ARview scale", "CustomScaleController: Scale clamped to minimum ${minScaleLimit} during gesture")
+      } else if (currentScale.x > maxScaleLimit) {
+        transformableNode.localScale = Vector3(maxScaleLimit, maxScaleLimit, maxScaleLimit)
+        Log.d("ARview scale", "CustomScaleController: Scale clamped to maximum ${maxScaleLimit} during gesture")
+      }
