+        val pos = transformableNode.localPosition
+        val s = transformableNode.localScale.x
+        transformableNode.localPosition = Vector3(pos.x, -groundOffsetY!! * s, pos.z)
+      }
+    }
+  }
+
+  override fun onEndTransformation(gesture: PinchGesture) {
+    super.onEndTransformation(gesture)
+    
+    // After scaling ends, ensure scale is within reasonable bounds
+    if (minScaleLimit != null && transformableNode != null) {
+      val currentScale = transformableNode.localScale
+      val maxScaleLimit = (initialScale ?: 1f) * 10f
