+      Availability.SUPPORTED_INSTALLED -> true
+      Availability.UNKNOWN_CHECKING -> {
+        Log.d("ARview session", "ARCore availability still checking")
+        mainHandler.postDelayed({ scheduleInitializeArView() }, 200)
