+    val absoluteMinScale = 0.2f
+    val relativeMinScale = scale * 0.5f
+    minScaleLimit = Math.max(absoluteMinScale, relativeMinScale)
+    
+    Log.d("ARview scale", "CustomScaleController: Initial scale set to $scale, minScaleLimit=${minScaleLimit}")
+  }
+  
