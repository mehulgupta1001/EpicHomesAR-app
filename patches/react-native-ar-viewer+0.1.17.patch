+  // Store the model's bottom offset (in model space) so we can keep feet on ground when scaling
+  private var groundOffsetY: Float? = null
+
+  // Track if we've captured the initial scale
+  private var hasCapturedInitialScale = false
+
+  /**
+   * Set the Y offset from model center to bottom (positive = down). Used to keep model base on surface when scaling.
+   */
+  fun setGroundOffsetY(value: Float) {
+    groundOffsetY = value
+    Log.d("ARview scale", "CustomScaleController: groundOffsetY set to $value (feet will stay on surface when scaling)")
+  }
+
+  /**
+   * Set the initial scale that should be preserved
+   * This should be called after the model's scale is set initially
+   */
